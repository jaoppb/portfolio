# Example Terraform variables
# Copy to terraform.tfvars or set TF_VAR_cloudflare_account_id
# Note: Ensure CLOUDFLARE_API_TOKEN is exported for Cloudflare provider authentication.
# For R2 remote state backend, export AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
cloudflare_account_id = "your-cloudflare-account-id"
project_name          = "jaoppb-portfolio"
domain_name           = "jaoppb.com"
production_branch     = "main"
