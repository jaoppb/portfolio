{
	"name": "portfolio",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"build": "pnpm -r --if-present run build",
		"check": "biome check .",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"prepare": "lefthook install",
		"quality:axe": "node quality/with-server.mjs pnpm run quality:axe:audit",
		"quality:axe:audit": "node quality/axe.mjs",
		"quality:lighthouse": "node quality/with-server.mjs pnpm run quality:lighthouse:audit",
		"quality:lighthouse:audit": "lhci autorun --config=quality/lighthouserc.cjs",
		"quality:lighthouse:summary": "node quality/lighthouse-summary.mjs",
		"quality:live": "node quality/live-check.mjs",
		"quality:serve": "wrangler pages dev apps/web/out --ip 127.0.0.1",
		"test": "pnpm -r --if-present run test",
		"test:quality": "node --test \"quality/*.test.mjs\"",
		"typecheck": "pnpm -r --if-present run typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@lhci/cli": "0.16.1",
		"axe-core": "4.14.0",
		"fallow": "^3.38.1",
		"lefthook": "^2.2.2",
		"puppeteer-core": "25.17.0",
		"wrangler": "4.158.0"
	}
}
